{% extends 'base.html.twig' %}

{% block page_title %}Invoice Overview{% endblock %}
{% block page_subtitle %}Comprehensive invoice analytics{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/custominvoiceview/invoice-overview.css') }}?v=1.0.1">
{% endblock %}

{% block main %}
    <div id="invoice-app">
        <div class="row">
            <div class="col-md-12">
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">Invoice Overview</h3>
                        <div class="box-tools pull-right">
                            <div class="btn-group year-switcher">
                                <button @click="previousYear" class="btn btn-sm btn-default">
                                    <i class="fa fa-chevron-left"></i> Previous Year
                                </button>
                                <button disabled class="btn btn-sm btn-info">
                                    [[ selectedYear ]]
                                </button>
                                <button @click="nextYear" :disabled="selectedYear >= currentYear" class="btn btn-sm btn-default">
                                    Next Year <i class="fa fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="box-body">
                        <!-- Loading indicator -->
                        <div v-if="loading" class="text-center" style="padding: 40px;">
                            <i class="fa fa-spinner fa-spin fa-3x"></i>
                            <p>Loading invoice data...</p>
                        </div>

                        <!-- Main content -->
                        <div v-else>
                            <!-- Summary cards -->
                            <div class="row summary-cards">
                                <div class="col-md-4">
                                    <div class="info-box bg-aqua">
                                        <span class="info-box-icon"><i class="fa fa-file-invoice-dollar"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Total Invoices</span>
                                            <span class="info-box-number">[[ invoices.length ]]</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="info-box bg-green">
                                        <span class="info-box-icon"><i class="fa fa-check-circle"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Total Paid</span>
                                            <span class="info-box-number">[[ formatCurrency(totalPaid) ]]</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="info-box bg-yellow">
                                        <span class="info-box-icon"><i class="fa fa-clock"></i></span>
                                        <div class="info-box-content">
                                            <span class="info-box-text">Total Pending</span>
                                            <span class="info-box-number">[[ formatCurrency(totalPending) ]]</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Chart -->
                            <div class="chart-container" style="position: relative; height: 400px; margin-bottom: 30px;">
                                <canvas id="invoiceChart"></canvas>
                            </div>

                            <!-- Invoice List -->
                            <div class="invoice-list">
                                <h4>Invoices for [[ selectedYear ]]</h4>
                                <div v-if="invoices.length === 0" class="alert alert-info">
                                    <i class="fa fa-info-circle"></i> No invoices found for this year.
                                </div>
                                <table v-else class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Invoice #</th>
                                            <th>Date</th>
                                            <th>Customer</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr v-for="invoice in invoices" :key="invoice.id">
                                            <td><strong>[[ invoice.number ]]</strong></td>
                                            <td>[[ formatDate(invoice.date) ]]</td>
                                            <td>[[ invoice.customer ]]</td>
                                            <td><strong>[[ formatCurrency(invoice.amount) ]]</strong></td>
                                            <td>
                                                <span :class="statusBadgeClass(invoice.status)">
                                                    [[ invoice.status ]]
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script>
        // Pass initial data to JavaScript
        window.initialInvoiceData = {{ data|json_encode|raw }};
        window.currentYear = {{ currentYear }};
    </script>
    <script src="{{ asset('bundles/custominvoiceview/invoice-overview.js') }}?v=1.0.1"></script>
{% endblock %}
